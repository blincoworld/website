{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piers-portfolio-static",
  "account_id": "c39888a9363fce8762763f0c60a9a388",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "piersblinco.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
